Checks: >-
  -*, bugprone-*, clang-analyzer-*, performance-*, portability-*, -portability-avoid-pragma-once,
  modernize-*, -modernize-use-trailing-return-type, -modernize-avoid-c-arrays,
  -modernize-use-nodiscard, -modernize-use-override, -modernize-loop-convert,
  -modernize-concat-nested-namespaces
WarningsAsErrors: '*'
HeaderFilterRegex: 'packages/(audio-protocol|serial-bridge)/.*'
FormatStyle: file
CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack